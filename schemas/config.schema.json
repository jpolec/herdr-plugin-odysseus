{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jpolec/herdr-plugin-odysseus/schemas/config.schema.json",
  "title": "herdr-orchestrator config (global or .ai/herdr-orchestrator/config.yaml)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "type": "string"
        },
        "runner": {
          "type": "string"
        },
        "base_branch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel_agents": {
          "type": "integer",
          "minimum": 1
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 50
        },
        "avoid_conflicts": {
          "type": "boolean",
          "default": true,
          "description": "Do not start a task whose scope overlaps an active run's scope or changed files."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_agents_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "max_runtime": {
          "description": "Duration: 45m, 2h, 1h30m, 90s, 500ms or seconds",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d))+$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "max_variants": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "description": "advisory; only with provider-reported usage"
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "agent_timeout": {
          "description": "Duration: 45m, 2h, 1h30m, 90s, 500ms or seconds",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d))+$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "command_timeout": {
          "description": "Duration: 45m, 2h, 1h30m, 90s, 500ms or seconds",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d))+$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "agent_startup_timeout": {
          "description": "Duration: 45m, 2h, 1h30m, 90s, 500ms or seconds",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d))+$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "approval_timeout": {
          "oneOf": [
            {
              "description": "Duration: 45m, 2h, 1h30m, 90s, 500ms or seconds",
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d))+$"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worktree_root": {
          "type": "string"
        },
        "branch_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]*$"
        },
        "auto_commit": {
          "type": "boolean"
        },
        "commit_message": {
          "type": "string"
        },
        "cleanup_on_success": {
          "type": "boolean"
        },
        "remote": {
          "type": "string"
        },
        "manage_exclude": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "builtin_default": {
          "type": "boolean"
        },
        "replace_global": {
          "type": "boolean"
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_pr": {
          "type": "boolean"
        },
        "auto_merge": {
          "const": false
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "push_before_pr": {
          "type": "boolean"
        },
        "watch_prs": {
          "type": "boolean",
          "default": false,
          "description": "While the engine runs, check open PRs of recent runs for failing CI and review comments and notify (never starts anything). Keeps the daemon up."
        },
        "watch_interval": {
          "description": "Duration: `45m`, `1h30m` or seconds.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "default": "10m"
        },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "auto_sync": {
              "type": "boolean",
              "default": false
            },
            "label": {
              "type": "string",
              "default": "herdr-orchestrator"
            },
            "import_label": {
              "type": "string",
              "default": "agent-ready"
            },
            "project": {
              "type": [
                "string",
                "null"
              ],
              "description": "Projects (v2) board as owner/number; needs the gh `project` scope."
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inherit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "set": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "inherit_all": {
          "type": "boolean"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hash_chain": {
          "type": "boolean"
        }
      }
    },
    "herdr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "required",
            "disabled"
          ]
        },
        "socket": {
          "type": [
            "string",
            "null"
          ]
        },
        "notify": {
          "type": "boolean"
        },
        "close_panes_on_success": {
          "type": "boolean"
        },
        "interrupt_on_timeout": {
          "type": "boolean"
        },
        "settle_window": {
          "description": "After a prompt, a 'finished' report without a result file is double-checked for this long",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d))+$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "sidebar_token": {
          "type": "string",
          "default": "orch",
          "pattern": "^([A-Za-z0-9_-]{1,32})?$",
          "description": "Sidebar token set on each run's workspace with its state (\u23f3 approve: \u2026, \u2192 step \u00b7 runner, \u2713 done\u2026). Show it with { token = \"$orch\" } in [ui.sidebar.spaces]. Empty disables."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excerpt_head_lines": {
          "type": "integer"
        },
        "excerpt_tail_lines": {
          "type": "integer"
        },
        "feedback_max_bytes": {
          "type": "integer"
        },
        "pane_read_lines": {
          "type": "integer"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "bubblewrap",
            "container",
            "macos_profile"
          ],
          "description": "only none is implemented"
        }
      }
    },
    "runners": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "pane",
              "headless",
              "shell"
            ]
          },
          "kind": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env_inherit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "tests",
          "lint",
          "security"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_logs": {
          "type": "boolean",
          "default": true,
          "description": "Read token usage of pane agents from their local session logs (~/.claude/projects, ~/.codex/sessions). Read-only, local."
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude_hook": {
          "type": "boolean",
          "default": true,
          "description": "Start Claude agents with a PreToolUse hook that blocks tool calls the policy denies, before they run."
        },
        "test_only_retry": {
          "type": "boolean",
          "default": true,
          "description": "After a failed check was fed back to an agent, ask a human if the new attempt changed only tests or test configuration."
        },
        "test_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Globs that count as tests or test/check configuration."
        },
        "watchdog": {
          "type": "object",
          "additionalProperties": false,
          "description": "Pane agents busy without progress are handed to a human (never failed).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "check_every": {
              "description": "Duration: `45m`, `1h30m` or seconds.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "default": "60s"
            },
            "stall_after": {
              "description": "Duration: `45m`, `1h30m` or seconds.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "default": "20m"
            },
            "idle_after": {
              "description": "Duration: `45m`, `1h30m` or seconds.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "default": "15m"
            },
            "burn_tokens": {
              "type": "integer",
              "minimum": 0,
              "default": 150000
            },
            "repeat_threshold": {
              "type": "integer",
              "minimum": 1,
              "default": 4
            }
          }
        },
        "learn_reminder": {
          "type": "integer",
          "minimum": 0,
          "default": 20,
          "description": "Notify (at most daily) when this many findings piled up since the last `learn`; 0 = never."
        }
      }
    },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adr_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "docs/adr",
            "doc/adr",
            "docs/decisions",
            "docs/architecture/decisions",
            "adr",
            ".ai/adr"
          ]
        },
        "max_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 12
        },
        "planner_runner": {
          "type": [
            "string",
            "null"
          ],
          "description": "Runner for planning and conformance agents (default: defaults.runner)."
        },
        "task_workflow": {
          "type": "string",
          "default": "epic-task"
        },
        "dependency_mode": {
          "enum": [
            "merged",
            "stacked"
          ],
          "default": "merged",
          "description": "merged: a dependency counts when its commits are in the base branch (local check). stacked: branch from the one unmerged dependency."
        }
      }
    },
    "sentry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Production errors from Sentry (`incidents`). Token only from SENTRY_AUTH_TOKEN.",
      "properties": {
        "url": {
          "type": "string",
          "default": "https://sentry.io"
        },
        "org": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": "string",
          "default": "is:unresolved"
        },
        "workflow": {
          "type": "string",
          "default": "contract-first"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "description": "Project memory: prior work in this repository put into implementing, contract and planning agents' prompts (never reviewers').",
      "properties": {
        "history": {
          "type": "boolean",
          "default": true
        },
        "max_records": {
          "type": "integer",
          "minimum": 1,
          "default": 8
        },
        "max_chars": {
          "type": "integer",
          "minimum": 500,
          "default": 6000
        },
        "active": {
          "type": "boolean",
          "default": true,
          "description": "Also list runs working in the repository right now."
        }
      }
    }
  }
}
